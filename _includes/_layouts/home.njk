{% set metaTitle = locale.metaTitle %}
{% set metaDescription = locale.metaDescription %}
{% set metaDescription = locale.metaDescription %}

<!doctype html>
<html lang="{{locale}}">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, minimum-scale=1.0, initial-scale=1.0, user-scalable=yes, shrink-to-fit=no">
    <meta name="color-scheme" content="light dark">
    <meta name="description" content="{{ metaDescription }}">

    <title>{{ title }} - {{ metaTitle }}</title>
    <link href="{{ '/assets/css/styles.css' | url }}" rel="stylesheet">
    <link rel="stylesheet" href="{% getBundleFileUrl "css" %}">
    
</head>
<body>
  {% include "top.njk" %}
  <div class="page">
    {% include "header.njk" %}
    <main id="main">
      <article class="page">
        {{ content | safe }}
      </article>
    </main>
    {% include "footer.njk" %}
  </div>
  {% include "translations.njk" %}
</body>
<script type="module" src="{% getBundleFileUrl "js" %}"></script>
</html>