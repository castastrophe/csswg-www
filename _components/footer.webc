<footer webc:root @attributes>
    <slot></slot>
</footer>

<style webc:scoped="site-footer">
    /* todo: maybe rework this to be more generic; double check styling */
    :host(:not(.page)) {
        background-color: var(--color-neutral); 
        color: var(--color-neutral-inverse);
        display: grid;
        grid-template-columns: 20px 1fr;
        @media (min-width: 50em) {
            grid-template-columns: 10vw 1fr 10vw;
        }
        padding: 1rem 0;
    }

    :host(:not(.page)) > * {
        grid-column: 2;
    }

    :host(.page) {
		clear: both;
		background: #eee;
		overflow: hidden; /* contain floats */
		padding: 1.2em 0 0 1.5em;
		font-size: 0.9em;
		line-height: 1.35;
    }

	:host(.page) img {
		float: left;
		margin: -1.2em 1em 0 0;
    }

	:host(.page) > p {
	    /* last updated timestamp */
		margin-bottom: 1em;
		text-transform: uppercase;
		font-size: 0.8em;
		line-height: 1.875;
    }
</style>